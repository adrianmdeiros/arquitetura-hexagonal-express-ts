{
  "name": "arquitetura-hexagonal",
  "version": "1.0.0",
  "description": "A Arquitetura Hexagonal, também conhecida como *Ports and Adapters*, é uma abordagem de design que visa isolar o núcleo da aplicação das dependências externas, como bancos de dados, interfaces de usuário, serviços externos, entre outros. Isso facilita a manutenção, teste e evolução do software.",
  "main": "main.js",
  "prisma": {
    "seed": "ts-node --transpile-only src/infra/prisma/database/seed.ts"
  },
  "scripts": {
    "prisma:seed": "npx prisma db seed",
    "prisma:migrate": "npx prisma migrate dev --schema=./src/infra/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=./src/infra/prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema=./src/infra/prisma/schema.prisma",
    "dev": "npm run prisma:generate && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts"
  },
  "keywords": [],
  "author": "adrianmdeiros",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.16.5",
    "prisma": "^6.12.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.0.5"
  }
}
